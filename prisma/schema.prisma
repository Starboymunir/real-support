generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// Enums

enum UserStatus {
  PENDING
  ACTIVE
  ONHOLD
  SUSPEND
}

enum CarStatus {
  ACTIVE
  INACTIVE
}

enum Subscription {
  DIAMOND
  GOLD
  SILVER
  NONE
}

enum Payment {
  CASH
  WALLET
  CASHANDWALLET
}

enum RideRequestStatus {
  PENDING
  CANCELLED
  ACCEPTED
}

enum BidStatus {
  PENDING
  REJECTED
  ACCEPTED
}

enum RequestType {
  ADJUSTABLE
  FIXED
}

enum UserMode {
  DRIVER
  PASSENGER
}

enum ContentType {
  aboutUs
  termsAndCondition
  privacyPolicy
}

enum BookingStatus {
  ACCEPTED
  REJECTED
  CANCELLED
  WAY_TO_PICKUP
  ARRIVED
  PICKED_UP
  WAY_TO_DESTINATION
  COMPLETED
}

enum ContactUsStatus {
  PENDING
  PROCESSING
  COMPLETED
}

enum SocialProvider {
  facebook
  twitter
  instagram
  linkedin
  youtube
  pinterest
  snapchat
  tiktok
  whatsapp
}

enum AccountStatus {
  REJECTED
  PENDING
  ACTIVE
}

enum RequestStatus {
  REJECTED
  PENDING
  PROCESSED
}

enum TransactionType {
  TOPUP
  EXPENSE
  WITHDRAW
  P2P_WALLET
  COMMISSION
  REQUEST
  DEPOSIT
  REFUND
  CANCELLATION_FEE
  BOOKING_INCOME
  ADMIN_COMMISSION
  ADMIN_CHARGE
  ADMIN_FUND
}

enum AdminTransactionType {
  INCOME
  EXPENSE
  COMMISSION
}

enum Role {
  SUPER_ADMIN
  ADMIN
}

enum PaymentOption {
  CASH_BALANCE
  BANK_TRANSFER
  CARD
  OTHER_OPTION
}

enum CompanyStatus {
  ACTIVE
  SUSPEND
  PENDING
  ONHOLD
}

enum AdminRole {
  ADMIN
  STAFF
}

enum DriverRequestStatus {
  ACTIVE
  SUSPEND
  PENDING
  ONHOLD
  DECLINE
}

enum DriverJoinRequestdBy {
  DRIVER
  COMPANY
}

enum ROC {
  REGISTER_COMPANY
  DRIVER_REQUEST
}

enum MessageSender {
  CLIENT
  ADMIN
}

// types

type DocumentVerification {
  isVerified  Boolean @default(false)
  isSubmitted Boolean @default(true)
  status      String  @default("Pending")
  isReturned  Boolean @default(false)
}

type BankDocument {
  sortCode      String?
  accountNumber String?
  bankName      String?
  accProfDoc    String?
  details       DocumentVerification
}

type PCODocument {
  pcoBadgeDocFront   String?
  pcoBadgeDocBack    String?
  pcoBadgeNumber     String?
  pcoBadgeExpiryDate DateTime?
  pcoPaperDoc        String?
  details            DocumentVerification
}

type DrivingLicense {
  licenseDocFront   String?
  licenseDocBack    String?
  licenseNumber     String?
  licenseExpiryDate DateTime?
  details           DocumentVerification?
}

type Passport {
  passportNumber     String?
  passportDocFront   String?
  passportDocBack    String?
  passportExpiryDate DateTime?
  details            DocumentVerification
}

type AddressProfDocument {
  addressProfDoc String?
  houseNumber    String?
  state          String?
  addressCode    String?
  streetAddress  String?
  city           String?
  details        DocumentVerification
}

type MOTDocument {
  motDoc      String?
  motPassDate DateTime?
  details     DocumentVerification
}

type InsuranceDocument {
  insuranceDoc        String?
  insuranceExpiryDate DateTime?
  details             DocumentVerification
}

type PCOVehicleLicense {
  pcoVehicleLicenseDoc        String?
  pcoVehicleLicenseExpiryDate DateTime?
  details                     DocumentVerification
}

type VehicleLogBook {
  vehicleLogBookDoc String?
  details           DocumentVerification
}

type Location {
  latitude  Float
  longitude Float
  accuracy  Float
  timestamp Float
}

// Models

model UserAddress {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  country     String
  state       String
  city        String
  houseNumber String
  streetName  String
  postalCode  String
  isDefault   Boolean @default(false)
  user        User    @relation(fields: [userId], references: [id])
  userId      String  @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  uniqueId  String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  firstName                String
  lastName                 String
  emailAddress             String             @unique
  password                 String?
  phone_number             String?
  address                  String?
  profileImageUrl          String?
  lastLogin                DateTime?          @db.Date
  coverImage               String?
  ratings                  Float              @default(5.0)
  mode                     UserMode           @default(PASSENGER)
  googleId                 String?
  appleId                  String?
  socketId                 String?
  isEmailConfirm           DateTime?
  isDeleted                Boolean            @default(false)
  emailVerificationOtp     String?
  emailVerificationExpiry  DateTime?
  resetToken               String?
  resetTokenExpiry         DateTime?
  currentLocation   Location?
  lastLocation      Location?
  wallet            Wallet?
  status            UserStatus         @default(ACTIVE)
  driver            Driver?
  notification      Notifications?
  bookings          Booking[]
  carts             Request[]
  bids              Bid[]
  userInfo          Transaction[]      @relation("userInfo")
  senderInfo        Transaction[]      @relation("senderInfo")
  receiverInfo      Transaction[]      @relation("receiverInfo")
  recipientInfo     PaymentRequests[]  @relation("recipient")
  payeeInfo         PaymentRequests[]  @relation("payee")
  WithDrawRequests  WithdrawRequests[] @relation("userInfo")
  AdminTransactions AdminTransaction[] @relation("userInfo")
  addresses         Address[]
  SocialLink        SocialLink[]
  bankAccounts      BankAccount[]
  contactUs         ContactUs[]        @relation("contactUsInfo")
  addressInfo       UserAddress[]
  chatParticipant   ChatParticipant[]
  senderMessage     ChatMessage[]
  cancelledBooking  Booking[]          @relation("cancelledBy")

  couponUsages CouponUsage[]
}

model Driver {
  id                      String          @id @default(auto()) @map("_id") @db.ObjectId
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  driverRecognitionNumber String?
  nationalInsuranceNumber String?         @unique
  selfAssessmentTaxId     String?         @unique
  dateOfBirth             DateTime?
  ratings                 Float           @default(5.0)
  totalJobComplete        Int             @default(0)
  currentLocation         Location?
  bio                     String?
  hobby                   String?
  address                 String?
  city                    String?
  postcode                String?
  userInfo                User?           @relation(fields: [driverUserId], references: [id])
  driverUserId            String?         @unique @db.ObjectId
  depositPaid             Boolean         @default(false)
  depositAmount           Float           @default(0.00)
  commissionPercentage    Float           @default(0.2)
  subscription            Subscription    @default(NONE)
  status                  UserStatus      @default(PENDING)
  isDeleted               Boolean         @default(false)
  isOnline                Boolean         @default(false)
  totalJobs               Booking[]
  document                Document?
  cars                    Car[]
  bids                    Bid[]
  packageIDs              String[]        @db.ObjectId
  driverRequest           DriverRequests?
  companyId               String?         @db.ObjectId
  companyInfo             Company?        @relation("companyDrivers", fields: [companyId], references: [id])
}

model Document {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  drivingLicense  DrivingLicense?
  bankDocuments   BankDocument?
  pcoDocuments    PCODocument?
  passport        Passport?
  workPermitCode  String?
  addressProfDocs AddressProfDocument?
  driverInfo      Driver?              @relation(fields: [driverId], references: [id])
  driverId        String               @unique @db.ObjectId
}

model Car {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  color       String
  carImage    String?
  engine      String
  make        String
  model       String
  year        String
  numberPlate String       @unique
  seats       Int?         @default(4)
  status      CarStatus    @default(INACTIVE)
  driverInfo  Driver       @relation(fields: [driverId], references: [id])
  driverId    String       @db.ObjectId
  carDocument CarDocument?
}

model CarDocument {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  motDocument       MOTDocument?
  insuranceDocument InsuranceDocument?
  pCOVehicleLicense PCOVehicleLicense?
  vehicleLogBook    VehicleLogBook?

  carInfo Car    @relation(fields: [carId], references: [id])
  carId   String @unique @db.ObjectId
}

model Address {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name               String?
  description        String?
  houseNumber        String?
  postCode           String?
  city               String
  streetName         String?
  notes              String?
  latitude           String
  longitude          String
  startAddress       Request? @relation("start")
  destinationAddress Request? @relation("destination")
  stoppages          Request? @relation("stoppage", fields: [requestId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  requestId          String?  @db.ObjectId

  bookingStart       Booking? @relation("bookingStart")
  bookingDestination Booking? @relation("bookingDestination")
  bookingStoppages   Booking? @relation("bookingStoppages", fields: [bookingId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bookingId          String?  @db.ObjectId
  userId             String?  @db.ObjectId
  userInfo           User?    @relation(fields: [userId], references: [id])
}

model Package {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()

  name            String    @unique
  summary         String
  description     String
  sortIndex       Int       @unique
  status          Boolean   @default(true)
  freeWaiting     Int       @default(180)
  cancellationFee Int       @default(4)
  serviceFee      Float     @default(1.00)
  maxServiceFee   Float     @default(10.00)
  pricePerMilage  Float     @default(2.40)
  drivingProMin   Float     @default(0.45)
  waitingProMin   Float     @default(0.30)
  vat             Float     @default(20)
  minBill         Float     @default(6.00)
  coverImage      String?
  carts           Request[]
  Booking         Booking[]
}

model StaticContent {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  title       String?
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @default(now())
  contentType ContentType @unique
}

model Request {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  startFrom        Address           @relation("start", fields: [startFromId], references: [id])
  startFromId      String            @unique @db.ObjectId
  destination      Address           @relation("destination", fields: [destinationId], references: [id])
  destinationId    String            @unique @db.ObjectId
  stoppages        Address[]         @relation("stoppage")
  bookingDate      DateTime?
  bookingTime      String?
  totalDuration    Float             @default(2.0)
  totalBill        Float?
  totalPersons     Int?
  totalLuggage     Int?
  totalDistance    Float             @default(2.0)
  notes            String?
  cashCollected    Float?            @default(0.00)
  walletCollected  Float?            @default(0.00)
  couponCode       String?
  couponExpiryDate DateTime?
  couponPercentage Float?
  discountAmount   Float?
  paymentType      Payment           @default(CASH)
  status           RideRequestStatus @default(PENDING)
  isRefunded       Boolean           @default(false)
  refundAmount     Float?
  packageInfo      Package           @relation(fields: [packageId], references: [id])
  packageId        String            @db.ObjectId
  serviceCharge    Float             @default(0.00)
  riderInfo        User              @relation(fields: [passengerId], references: [id])
  passengerId      String            @db.ObjectId
  clientName       String
  clientEmail      String
  clientPhone      String?
  requestType      RequestType       @default(FIXED)
  booking          Booking?
  bids             Bid[]
  budget           Float?
  rejectedByIds    String[]          @db.ObjectId
}

model Bid {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requestId   String  @db.ObjectId
  requestInfo Request @relation(fields: [requestId], references: [id])

  bidAmount  Float
  driverId   String @db.ObjectId
  driverInfo Driver @relation(fields: [driverId], references: [id])

  passengerId String @db.ObjectId
  riderInfo   User   @relation(fields: [passengerId], references: [id])

  status BidStatus @default(PENDING)
}

model Booking {
  id                  String    @id @default(auto()) @map("_id") @db.ObjectId
  uniqueId            String    @unique
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  //Addresses
  startFrom           Address   @relation("bookingStart", fields: [startFromId], references: [id])
  startFromId         String    @unique @db.ObjectId
  destination         Address   @relation("bookingDestination", fields: [destinationId], references: [id])
  destinationId       String    @unique @db.ObjectId
  stoppages           Address[] @relation("bookingStoppages")
  // Driver & Passenger
  driverInfo          Driver    @relation(fields: [driverId], references: [id])
  driverId            String    @db.ObjectId
  driverName          String
  driverEmail         String
  driverPhone         String
  NINumber            String?
  selfAssessmentTaxId String?
  driverRating        Float     @default(5.0)
  driverReview        String?
  commission          Float
  vehicleNumberPlate  String

  riderId              String    @db.ObjectId
  riderInfo            User      @relation(fields: [riderId], references: [id])
  riderName            String
  riderPhone           String?
  riderEmail           String
  riderRating          Float     @default(5.0)
  riderReview          String?
  commissionPercentage Float     @default(0.00)
  // Payment
  paymentType          Payment   @default(CASH)
  paymentStatus        Boolean   @default(false) // missing
  couponCode           String?
  couponExpiryDate     DateTime?
  couponPercentage     Float?
  discountAmount       Float?    @default(0.00)
  cashCollected        Float?    @default(0.00)
  walletCollected      Float?    @default(0.00)
  finalBill            Float
  totalBill            Float

  requestId     String      @unique @db.ObjectId
  requestInfo   Request?    @relation(fields: [requestId], references: [id])
  requestType   RequestType @default(FIXED)
  packageId     String      @db.ObjectId
  packageInfo   Package     @relation(fields: [packageId], references: [id])
  packageName   String
  serviceCharge Float       @default(0.00)

  status                   BookingStatus @default(ACCEPTED)
  acceptedAt               DateTime      @default(now())
  totalPersons             Int?
  totalLuggage             Int?
  notes                    String?
  bookingDate              DateTime
  bookingTime              String
  totalDistance            Float
  totalDuration            Float         @default(2.0)
  cancelledBy              User?         @relation("cancelledBy", fields: [cancelledById], references: [id])
  cancelledById            String?       @db.ObjectId
  cancelReason             String?
  cancelTime               DateTime?
  isRefunded               Boolean       @default(false)
  refundAmount             Float?
  cancellationFee          Float?
  cancellationFeeCollected Boolean?      @default(false)
  totalWaitingTime         Int?
  wayToPickupAt            DateTime?
  arrivedAt                DateTime?
  pickedUpAt               DateTime?
  completedAt              DateTime?
  isAllowGenerateInvoice   Boolean       @default(false)
  invoice                  Invoice?
  transaction              Transaction[]
  chat                     Chat[]
}

model Invoice {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookingInfo Booking @relation(fields: [bookingId], references: [id])
  bookingId   String  @unique @db.ObjectId
}

model Wallet {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId       String        @unique @db.ObjectId
  userInfo     User          @relation(fields: [userId], references: [id])
  balance      Float         @default(0.00)
  transactions Transaction[]
}

model PaymentRequests {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipientId String        @db.ObjectId
  recipient   User          @relation("recipient", fields: [recipientId], references: [id])
  payeeId     String        @db.ObjectId
  payee       User          @relation("payee", fields: [payeeId], references: [id])
  amount      Float         @default(0.00)
  onAccountOf String
  remarks     String?
  status      RequestStatus @default(PENDING)
  transaction Transaction[]
}

model Transaction {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userInfo User   @relation("userInfo", fields: [userId], references: [id])
  userId   String @db.ObjectId

  paymentRequest    PaymentRequests?  @relation(fields: [paymentRequestId], references: [id])
  withdrawRequest   WithdrawRequests? @relation(fields: [withdrawRequestId], references: [id])
  booking           Booking?          @relation(fields: [bookingId], references: [id])
  bookingId         String?           @db.ObjectId
  wallet            Wallet?           @relation(fields: [walletId], references: [id])
  walletId          String?           @db.ObjectId
  senderInfo        User?             @relation("senderInfo", fields: [senderId], references: [id])
  senderId          String?           @db.ObjectId
  amount            Float             @default(0.00)
  balanceBefore     Float             @default(0.00)
  balanceAfter      Float             @default(0.00)
  narration         String?
  type              TransactionType   @default(EXPENSE)
  withdrawRequestId String?           @db.ObjectId
  receiverId        String?           @db.ObjectId
  receiverInfo      User?             @relation("receiverInfo", fields: [receiverId], references: [id])
  paymentRequestId  String?           @db.ObjectId
  stripeId          String?
}

model AdminTransaction {
  id        String               @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  amount    Float
  userId    String               @db.ObjectId
  userInfo  User?                @relation("userInfo", fields: [userId], references: [id])
  type      AdminTransactionType @default(INCOME)
  narration String?
}

model WithdrawRequests {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  userId      String        @db.ObjectId
  userInfo    User          @relation("userInfo", fields: [userId], references: [id])
  proceededBy String?       @db.ObjectId
  proceeder   Admin?        @relation("proceeder", fields: [proceededBy], references: [id])
  amount      Float         @default(0.00)
  status      RequestStatus @default(PENDING)
  transaction Transaction[]
  notes       String?
}

model DiscountCoupons {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  coupon       String        @unique
  discount     Float
  expiry       DateTime
  isActive     Boolean       @default(true)
  useability   Int           @default(1)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  couponUsages CouponUsage[]
}

model CouponUsage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  couponId String          @db.ObjectId
  coupon   DiscountCoupons @relation(fields: [couponId], references: [id])

  usedAt DateTime @default(now())
}

model ContactUs {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name         String
  email        String
  phone_number String
  reason       String
  status       ContactUsStatus @default(PENDING)
  userId       String?         @db.ObjectId
  userInfo     User?           @relation("contactUsInfo", fields: [userId], references: [id])

  messages ContactUsMessage[]
}

model ContactUsMessage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())

  contactUsId String    @db.ObjectId
  contactUs   ContactUs @relation(fields: [contactUsId], references: [id])

  sender  MessageSender
  content String
}

model SocialLink {
  id     String         @id @default(auto()) @map("_id") @db.ObjectId
  userId String         @db.ObjectId
  type   SocialProvider
  link   String
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BankAccount {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  bankName      String
  accountName   String
  accountNumber String
  sortCode      String
  document      String?
  isDefault     Boolean       @default(false)
  status        AccountStatus @default(PENDING)

  user   User   @relation(fields: [userId], references: [id])
  userId String @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Admin {
  id                      String             @id @default(auto()) @map("_id") @db.ObjectId
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  firstName               String
  lastName                String
  email                   String             @unique
  password                String
  phone_number            String?
  profileImageUrl         String?
  coverImage              String?
  role                    Role               @default(ADMIN)
  lastLogin               DateTime?          @db.Date
  otp                     Int?
  status                  Boolean            @default(false)
  isEmailConfirm          DateTime?
  emailVerificationOtp    String?
  emailVerificationExpiry DateTime?
  resetToken              String?
  resetTokenExpiry        DateTime?
  expenseRecord           Expenses?
  incomeRecord            Income?
  accountRecord           Account?
  proceeder               WithdrawRequests[] @relation("proceeder")
  company                 Company?
}

model Expenses {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  documentImages String[]
  amount         Float         @default(0.00)
  paidOption     PaymentOption @default(OTHER_OPTION)
  paidOptionNote String
  paidTo         String
  date           DateTime
  recodedBy      Admin?        @relation(fields: [adminId], references: [id])
  adminId        String        @unique @db.ObjectId
}

model Income {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documentImages String[]
  amount         Float         @default(0.00)
  payOption      PaymentOption @default(OTHER_OPTION)
  payOptionNote  String
  receivedFrom   String
  date           DateTime
  recodedBy      Admin?        @relation(fields: [adminId], references: [id])
  adminId        String        @unique @db.ObjectId
}

model Account {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cashBalance  Float  @default(0.00)
  bankBalance  Float  @default(0.00)
  otherBalance Float  @default(0.00)
  updatedBy    Admin? @relation(fields: [adminId], references: [id])
  adminId      String @unique @db.ObjectId
}

model Chat {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  isGroupChat Boolean @default(false)
  isAdminChat Boolean @default(false)

  bookingId String?  @db.ObjectId
  booking   Booking? @relation(fields: [bookingId], references: [id])

  adminId         String?   @db.ObjectId
  adminLastReadAt DateTime?

  // Relations
  participants ChatParticipant[] @relation()
  messages     ChatMessage[]     @relation()

  // Timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model ChatMessage {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  senderId    String?  @db.ObjectId
  sender      User?    @relation(fields: [senderId], references: [id])
  content     String?
  attachments String[] @default([])
  chatId      String?  @db.ObjectId
  chat        Chat?    @relation(fields: [chatId], references: [id], onDelete: Cascade)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChatParticipant {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  chatId     String    @db.ObjectId
  userId     String    @db.ObjectId
  lastReadAt DateTime?

  // Relations
  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])
}

model Company {
  id                            String           @id @default(auto()) @map("_id") @db.ObjectId
  createdAt                     DateTime         @default(now())
  updatedAt                     DateTime         @updatedAt
  companyName                   String?
  companyAddress                CompanyAddress?
  phone_number                  String?
  companyEmail                  String           @unique
  description                   String?
  coverImage                    String?
  HMRC_RegistrationNumber       String?
  VAT_RegistrationNumber        String?
  PCO_OperatorLicenseNumber     String?
  PCO_OperatorLicenseExpiryDate DateTime?
  PCO_OperatorLicenseIssueDate  DateTime?
  status                        CompanyStatus    @default(PENDING)
  companyAdmins                 CompanyAdmins[]
  notifications                 Notifications[]
  companyDrivers                DriverRequests[]
  drivers                      Driver[]         @relation("companyDrivers")

  contactPerson String? @unique @db.ObjectId
  userInfo      Admin?  @relation(fields: [contactPerson], references: [id])
}

model CompanyAddress {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  houseNumber String?
  streetName  String
  postCode    String
  city        String
  latitude    String?
  longitude   String?
  companyId   String?  @unique @db.ObjectId
  companyInfo Company? @relation(fields: [companyId], references: [id])
}

model CompanyAdmins {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyAdminEmail    String
  companyAdminPassword String?
  memorableNumber      String
  Name                 String
  Surname              String
  avatar               String?
  status               Boolean   @default(false)
  adminRole            AdminRole @default(STAFF)
  companyId            String    @db.ObjectId
  companyInfo          Company?  @relation(fields: [companyId], references: [id])
}

model DriverRequests {
  id                 String               @id @default(auto()) @map("_id") @db.ObjectId
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  companyId          String               @db.ObjectId
  companyInfo        Company?             @relation(fields: [companyId], references: [id])
  status             DriverRequestStatus  @default(PENDING)
  statusBySuperAdmin DriverRequestStatus  @default(PENDING)
  requestedBy        DriverJoinRequestdBy @default(DRIVER)

  driverId   String  @unique() @db.ObjectId
  driverInfo Driver? @relation(fields: [driverId], references: [id])
}

model Notifications {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  ROC         ROC      @default(REGISTER_COMPANY)
  remarks     String?
  userInfo    User?    @relation(fields: [userId], references: [id])
  userId      String?  @unique @db.ObjectId
  isRead      Boolean  @default(false)
  companyId   String?  @db.ObjectId
  companyInfo Company? @relation(fields: [companyId], references: [id])
}

model News {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  news      String
  comment   String?
}

model Airport {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  name       String
  code       String   @unique
  dropoffFee Float
  parkingFee Float
  isActive   Boolean  @default(true)
}
